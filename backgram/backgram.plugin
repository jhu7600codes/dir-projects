__id__ = "backgram"
__name__ = "Backgram"
__version__ = "0.5.0"
__author__ = "@jhu7600"
__min_version__ = "12.1.1"
__description__ = (
    "Backports newer Telegram protocol features into older exteraGram/AyuGram builds.\n"
    "Stage 1: raises the declared MTProto layer and reports what the server starts sending.\n\n"
    "Бэкпортит новые возможности протокола Telegram в старые сборки exteraGram/AyuGram."
)

import sys
import traceback

from base_plugin import BasePlugin, HookResult, HookStrategy, MethodHook
from ui.settings import Divider, Header, Switch, Text
from ui.bulletin import BulletinHelper
from hook_utils import find_class

# ---------------------------------------------------------------------------
# "Rich messages" (TL_iv.RichMessage, constructor 0xbaf39d8b) are a protocol
# feature: the server only sends them to clients that declare a high enough
# MTProto layer. The declared layer travels from Java into native tgnet via
#   ConnectionsManager.init(version, layer, apiId, ...)  ->  native_init(...)
#
# The catch, found the hard way in 0.1.0: init() is not called from some late
# startup path that a plugin can get ahead of. It is called from the
# ConnectionsManager *constructor*, which runs the first time anything touches
# getInstance(account) - long before the plugin engine loads us. So hooking
# init() alone attaches a hook that will never fire again this process.
#
# So the plugin makes init() run again. Not by rebuilding its fifteen arguments
# - that does not survive R8, which inlines BuildVars.APP_ID and friends into
# their callers and then deletes the fields, and renames AndroidUtilities'
# helpers out from under any lookup by name. Instead it constructs a throwaway
# ConnectionsManager, whose constructor assembles those arguments with the app's
# own code and calls init(), where the layer hook is already waiting.
#
# Re-entering native_init on a live connection is not something the app ever
# does, so that sits behind its own switch, off by default.
# ---------------------------------------------------------------------------

TARGET_LAYER = 229

# Types whose wire id changed between a 12.5.x build and layer 229. If these
# start arriving, the old class will mis-read the stream, so they are worth
# calling out separately from merely-unknown constructors.
CHANGED_CONSTRUCTORS = {
    0x033ED001: "connectedBot",
    0x773F4E66: "messageMediaPoll",
    0x71E4EA58: "reactionsNotifySettings",
    0x16A4B93C: "storyItem",
    0x2C63A72B: "stories.editStory",
    0x8F9E6898: "stories.sendStory",
}

RICH_MESSAGE_CONSTRUCTOR = 0xBAF39D8B

PROBE_TARGETS = (
    "org.telegram.tgnet.TLRPC$Message",
    "org.telegram.tgnet.TLRPC$MessageMedia",
    "org.telegram.tgnet.TLRPC$MessageEntity",
    "org.telegram.tgnet.TLRPC$RichText",
    "org.telegram.tgnet.TLRPC$PageBlock",
    "org.telegram.tgnet.TLRPC$Update",
)


def _u32(value):
    """TL constructor ids are unsigned; Java hands them over as signed ints."""
    return value & 0xFFFFFFFF


def _java_class(name):
    """find_class gives back a class proxy; the reflection API wants java.lang.Class.

    Which of the two spellings works depends on the host's binding, so try both
    and let the caller treat a None as "not reachable".
    """
    try:
        found = find_class(name)
    except Exception:
        return None
    if found is None:
        return None
    for accessor in (lambda: found.getClass(), lambda: found):
        try:
            candidate = accessor()
            candidate.getDeclaredMethods()
            return candidate
        except Exception:
            continue
    return None


def _method(cls, name, argc):
    """Match by name and arity rather than exact parameter classes.

    getMethod(name, Class...) needs the parameter types spelled right, and a
    near miss returns nothing at all; arity is enough to pick these out.
    """
    try:
        for method in cls.getMethods():
            if method.getName() == name and len(method.getParameterTypes()) == argc:
                method.setAccessible(True)
                return method
    except Exception:
        pass
    return None


class _LayerHook(MethodHook):
    """Rewrites the layer argument on its way into native tgnet."""

    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        try:
            self.plugin.init_fires += 1
            if not self.plugin.layer_enabled:
                return
            args = param.args
            if len(args) < 3:
                return
            original = args[1]
            if original is None or int(original) >= TARGET_LAYER:
                return
            self.plugin.original_layer = int(original)
            args[1] = TARGET_LAYER
            self.plugin.init_rewrites += 1
            self.plugin.log(
                "layer raised %s -> %s" % (self.plugin.original_layer, TARGET_LAYER)
            )
        except Exception:
            self.plugin.log("layer hook failed:\n" + traceback.format_exc())


class _DeserializeHook(MethodHook):
    """Counts constructors the running build cannot deserialize."""

    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            self.plugin.deserialize_calls += 1
            if param.getResult() is not None:
                return
            args = param.args
            if len(args) < 2:
                return
            self.plugin.note_unknown(_u32(int(args[1])))
        except Exception:
            pass


class BackgramPlugin(BasePlugin):

    def __init__(self):
        super().__init__()
        self.layer_enabled = False
        self.original_layer = None
        self.build_layer = None
        self.unknown_counts = {}
        self.rich_seen = 0
        self.init_fires = 0
        self.init_rewrites = 0
        self.deserialize_calls = 0
        self.probes_attached = 0
        self.errors = []
        self._hooks = []

    # -- lifecycle ---------------------------------------------------------

    def on_plugin_load(self):
        self.layer_enabled = self.get_setting("force_layer", False)
        self.build_layer = self._read_build_layer()
        # The probe is read-only, so it runs regardless of the layer switch.
        # Without it, "nothing unknown seen" cannot be told apart from
        # "nothing was ever watching".
        self._install_probe()
        self._install_layer_hook()
        if self.layer_enabled and self.get_setting("reinit", False):
            self._reinit_accounts()

    def on_plugin_unload(self):
        for ref in self._hooks:
            try:
                self.unhook_method(ref)
            except Exception:
                pass
        self._hooks = []

    def _fail(self, what):
        # A Java exception's text carries its whole stack trace, so keep only
        # the first line - the reason. The full trace still goes to the log.
        try:
            reason = traceback.format_exception_only(*sys.exc_info()[:2])[0]
            reason = reason.strip().split("\n")[0]
        except Exception:
            reason = "unknown"
        self._note_error("%s: %s" % (what, reason))
        self.log(what + "\n" + traceback.format_exc())

    def _note_error(self, message):
        """Keep one copy of each. The same failure per account is one fact."""
        if message not in self.errors:
            self.errors.append(message)

    # -- hook installation -------------------------------------------------

    def _read_build_layer(self):
        """Read TLRPC.LAYER if R8 left the field behind.

        It usually has not: the field is static final, so every reader gets the
        constant inlined and the field itself is dropped. That is expected, not
        a fault, so this stays out of the error list - the hook reports the real
        layer anyway once it fires.
        """
        try:
            cls = _java_class("org.telegram.tgnet.TLRPC")
            if cls is None:
                return None
            field = cls.getDeclaredField("LAYER")
            field.setAccessible(True)
            return int(field.getInt(None))
        except Exception:
            return None

    def _find_init(self, cls):
        for method in cls.getDeclaredMethods():
            if method.getName() != "init":
                continue
            types = method.getParameterTypes()
            # init(version, layer, apiId, ...) - three leading ints
            if len(types) >= 3 and all(t.getName() == "int" for t in types[:3]):
                return method
        return None

    def _install_layer_hook(self):
        try:
            cls = _java_class("org.telegram.tgnet.ConnectionsManager")
            if cls is None:
                self._note_error("ConnectionsManager not reachable")
                return
            method = self._find_init(cls)
            if method is None:
                self._note_error("ConnectionsManager.init(int,int,int,...) not found")
                return
            self._hooks.append(self.hook_method(method, _LayerHook(self)))
        except Exception:
            self._fail("layer hook install failed")

    def _install_probe(self):
        for class_name in PROBE_TARGETS:
            try:
                cls = _java_class(class_name)
                if cls is None:
                    continue
                for method in cls.getDeclaredMethods():
                    if method.getName() == "TLdeserialize":
                        self._hooks.append(
                            self.hook_method(method, _DeserializeHook(self))
                        )
                        self.probes_attached += 1
                        break
            except Exception:
                # A probe that cannot attach is not worth failing the plugin for.
                continue

    # -- re-init -----------------------------------------------------------

    def _reinit_accounts(self):
        """Re-run init() by constructing a throwaway ConnectionsManager.

        Rebuilding init()'s fifteen arguments by hand does not survive
        minification - BuildVars.APP_ID and friends are inlined constants whose
        fields R8 deletes, and AndroidUtilities' helpers get renamed. The
        constructor assembles all of them using the app's own code, then calls
        init(), where the layer hook is already waiting. So construct one and
        throw it away: the Java object is not the point, the native_init call
        it makes on the way is. The real singleton in Instance[] is untouched.
        """
        try:
            cls = _java_class("org.telegram.tgnet.ConnectionsManager")
            proxy = find_class("org.telegram.tgnet.ConnectionsManager")
            if cls is None or proxy is None:
                self._note_error("re-init: ConnectionsManager not reachable")
                return

            done = 0
            for account in self._live_accounts(cls):
                try:
                    # Call the constructor through the class proxy rather than
                    # reflectively. Reflection takes Object..., and the binding
                    # boxes a Python int as java.lang.Long, which will not match
                    # an int parameter; a direct call knows the parameter type
                    # and converts.
                    proxy(account)
                    done += 1
                except Exception:
                    # Not per-account: the same reason four times is one fact.
                    self._fail("re-init failed")
            self.log("re-init applied to %d account(s)" % done)
        except Exception:
            self._fail("re-init failed")

    def _live_accounts(self, cls):
        """Accounts that already have a ConnectionsManager, found by field type.

        Every name here would be renamed by R8, so the private Instance[] array
        is located by its type instead: a static array of ConnectionsManager.
        An entry being non-null means that account's native slot was inited,
        which is exactly the set worth re-initing.
        """
        try:
            for field in cls.getDeclaredFields():
                field_type = field.getType()
                if not field_type.isArray():
                    continue
                if field_type.getComponentType().getName() != cls.getName():
                    continue
                field.setAccessible(True)
                instances = field.get(None)
                if instances is None:
                    break
                found = [i for i in range(len(instances)) if instances[i] is not None]
                if found:
                    return found
                break
        except Exception:
            self._fail("could not locate the account array")
        return [0]

    # -- diagnostics -------------------------------------------------------

    def note_unknown(self, constructor):
        if constructor == RICH_MESSAGE_CONSTRUCTOR:
            self.rich_seen += 1
            self.log("rich message constructor observed (0x%08x)" % constructor)
            return
        self.unknown_counts[constructor] = self.unknown_counts.get(constructor, 0) + 1
        if constructor in CHANGED_CONSTRUCTORS:
            self.log(
                "changed-wire-format type arrived: %s (0x%08x)"
                % (CHANGED_CONSTRUCTORS[constructor], constructor)
            )

    def _report(self):
        # TLRPC.LAYER is static final, so R8 inlines it and drops the field.
        # When that happens the only honest source is the value the hook saw.
        layer = self.build_layer or self.original_layer
        lines = [
            "build layer: %s" % (layer if layer else "stripped by R8"),
            "probes attached: %d/%d" % (self.probes_attached, len(PROBE_TARGETS)),
            "deserialize calls seen: %d" % self.deserialize_calls,
            "init hook fired: %d (rewrote %d)" % (self.init_fires, self.init_rewrites),
            "rich messages seen: %d" % self.rich_seen,
        ]

        if self.probes_attached == 0:
            lines.append("")
            lines.append("-> nothing is watching; hooking itself is broken.")
        elif self.deserialize_calls == 0:
            lines.append("")
            lines.append("-> probes attached but never ran; wrong classes.")
        elif self.init_fires == 0:
            lines.append("")
            if self.get_setting("reinit", False):
                lines.append(
                    "-> re-init ran but never reached init(); see the error below."
                )
            else:
                lines.append(
                    "-> init() never ran after load, so the layer is untouched. "
                    "Turn on 'Re-init connections' and restart."
                )
        elif self.init_rewrites == 0:
            lines.append("")
            lines.append("-> init() ran but the layer was already >= %d." % TARGET_LAYER)

        if self.unknown_counts:
            lines.append("")
            ranked = sorted(self.unknown_counts.items(), key=lambda kv: -kv[1])
            for constructor, count in ranked[:10]:
                label = CHANGED_CONSTRUCTORS.get(constructor, "unknown")
                lines.append("0x%08x  x%-4s %s" % (constructor, count, label))

        for message in self.errors[:4]:
            lines.append("! " + message)

        return "\n".join(lines)

    # -- settings ----------------------------------------------------------

    def create_settings(self):
        return [
            Header(text="Protocol"),
            Switch(
                key="force_layer",
                text="Declare layer %s" % TARGET_LAYER,
                default=False,
                subtext=(
                    "Tells the server this client speaks a newer protocol, which is "
                    "what makes it send rich messages at all. Requires a restart. "
                    "Polls and stories may mis-render while this is on."
                ),
                icon="msg_sendfile",
                on_change=self._on_setting_changed,
            ),
            Switch(
                key="reinit",
                text="Re-init connections",
                default=False,
                subtext=(
                    "The app sets its layer before plugins load, so the hook alone "
                    "arrives too late. This re-runs the setup with the new layer. "
                    "It is the risky part - if the app misbehaves, turn this off "
                    "first."
                ),
                icon="msg_retry",
                on_change=self._on_setting_changed,
            ),
            Divider(text="This build ships layer %s."
                    % (self.build_layer or self.original_layer or "?")),

            Header(text="Diagnostics"),
            # The counters go in the divider rather than only in a bulletin: a
            # bulletin shows two lines and then gives up, which made 0.2.0's
            # readout unreadable on a phone. Re-opening this screen refreshes it.
            Divider(text=self._report()),
            Text(
                text="Copy report",
                icon="msg_copy",
                on_click=self._copy_report,
            ),
            Divider(
                text=(
                    "Stage 1 only measures. Once this shows rich messages arriving, "
                    "the decoder is worth building - your app already ships the "
                    "instant-view renderer they are made of."
                )
            ),
        ]

    def _on_setting_changed(self, value):
        self.layer_enabled = self.get_setting("force_layer", False)
        BulletinHelper.show_info("Restart the app to apply")

    def _copy_report(self, _view=None):
        text = self._report()
        if self._to_clipboard(text):
            BulletinHelper.show_info("Report copied")
        else:
            # Better a truncated bulletin than nothing at all.
            BulletinHelper.show_info(text)

    def _to_clipboard(self, text):
        try:
            context = find_class("org.telegram.messenger.ApplicationLoader").applicationContext
            clipboard = context.getSystemService("clipboard")
            if clipboard is None:
                return False
            clip_data_cls = _java_class("android.content.ClipData")
            manager_cls = _java_class("android.content.ClipboardManager")
            if clip_data_cls is None or manager_cls is None:
                return False
            new_plain_text = _method(clip_data_cls, "newPlainText", 2)
            set_clip = _method(manager_cls, "setPrimaryClip", 1)
            if new_plain_text is None or set_clip is None:
                return False
            clip = new_plain_text.invoke(None, "Backgram", text)
            # Invoke reflectively: getSystemService is typed as Object, so the
            # binding will not find setPrimaryClip on it directly.
            set_clip.invoke(clipboard, clip)
            return True
        except Exception:
            self._fail("clipboard copy failed")
            return False
