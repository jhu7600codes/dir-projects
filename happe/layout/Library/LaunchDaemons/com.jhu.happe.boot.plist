<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- runs once when the jailbreak loads LaunchDaemons: reconnects if you were connected -->
	<key>Label</key>
	<string>com.jhu.happe.boot</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/libexec/happe/happectl</string>
		<string>boot</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/var/log/happe-boot.log</string>
	<key>StandardErrorPath</key>
	<string>/var/log/happe-boot.log</string>
</dict>
</plist>
