<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- No permissions needed: gameplay is fully offline (local DataStore save file only),
         and the Appteka achievement links are opened via ACTION_VIEW, which needs INTERNET
         in the browser handling the intent, not in this app. -->

    <application
        android:name=".OrbitalSurfApp"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.OrbitalSurf"
        android:supportsRtl="true"
        android:hardwareAccelerated="true"
        tools:targetApi="34">

        <activity
            android:name=".ui.MainMenuActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:launchMode="singleTop"
            android:theme="@style/Theme.OrbitalSurf">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The GLSurfaceView game screen: the whole app is landscape-locked (see every
             activity below), and configChanges keeps a rotation between landscape/reverse
             landscape from restarting the activity, which would lose the running GameSession. -->
        <activity
            android:name=".ui.GameActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize"
            android:theme="@style/Theme.OrbitalSurf.Game"
            android:parentActivityName=".ui.MainMenuActivity" />

        <activity
            android:name=".ui.ShopActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:label="@string/shop_title"
            android:parentActivityName=".ui.MainMenuActivity" />

        <activity
            android:name=".ui.AchievementsActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:label="@string/achievements_title"
            android:parentActivityName=".ui.MainMenuActivity" />

        <activity
            android:name=".ui.DailyChallengesActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:label="@string/daily_challenges_title"
            android:parentActivityName=".ui.MainMenuActivity" />

        <activity
            android:name=".ui.ResultsActivity"
            android:exported="false"
            android:label="@string/results_title"
            android:screenOrientation="landscape"
            android:parentActivityName=".ui.MainMenuActivity" />

    </application>

</manifest>
