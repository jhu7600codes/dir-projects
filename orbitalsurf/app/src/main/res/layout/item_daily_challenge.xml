<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/challengeDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="@color/orbital_on_surface"
        android:textSize="15sp"
        tools:text="Score 12,000+ in a single run without using any powerups" />

    <TextView
        android:id="@+id/challengeReward"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/orbital_plates_gold"
        android:textSize="14sp"
        android:textStyle="bold"
        tools:text="+150 plates" />

</LinearLayout>
