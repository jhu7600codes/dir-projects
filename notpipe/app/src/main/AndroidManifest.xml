<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.gohoski.notpipe" android:installLocation="auto">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- TV: no touchscreen needed, shown in the Android TV launcher -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <application
        android:name=".NotPipe"
        android:allowBackup="true"
        android:icon="@drawable/main_icon"
        android:logo="@drawable/actionbar_logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/main_icon"
        android:banner="@drawable/tv_banner"
        android:theme="@style/AppTheme">
        <activity
            android:label="@string/app_name"
            android:name="io.github.gohoski.notpipe.MainActivity"
            android:configChanges="keyboardHidden">
            <intent-filter >
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".SearchActivity"
            android:label="@string/search"
            android:windowSoftInputMode="stateVisible|adjustResize" />
        <activity android:name=".SettingsActivity"
            android:label="@string/settings" />
        <activity android:name=".VideoActivity"
            android:label="@string/app_name"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|keyboardHidden|screenLayout">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:host="www.youtube.com" />
                <data android:host="m.youtube.com" />
                <data android:host="youtube.com" />
                <data android:pathPrefix="/watch" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:host="youtu.be" />
            </intent-filter>
        </activity>
        <activity android:name=".ChannelActivity"
            android:label="@string/channel" />
        <activity android:name=".LibraryActivity"
            android:label="@string/library" />
        <activity android:name=".DownloadsActivity"
            android:label="@string/downloads" />
        <activity android:name=".VideoListActivity"
            android:label="@string/playlist">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:host="www.youtube.com" />
                <data android:host="m.youtube.com" />
                <data android:host="youtube.com" />
                <data android:pathPrefix="/playlist" />
            </intent-filter>
        </activity>
        <activity android:name=".TvActivity"
            android:label="@string/app_name"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".GsignActivity"
            android:label="@string/sign_in_yt2009"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout" />
        <activity android:name=".ShortsActivity"
            android:label="@string/shorts"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout" />
        <activity android:name=".UploadActivity"
            android:label="@string/upload_video"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout" />
        <service android:name=".MusicService" />
        <service android:name=".NewVideosService" />
        <receiver android:name=".NewVideosService$BootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <service android:name=".DownloadService" />
    </application>
</manifest>
