<?xml version="1.0" encoding="utf-8"?>
<!-- Flat dark search box with sharp corners; blue outline while focused -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="#FF1C1C1C"/>
            <stroke android:width="1dp" android:color="#FF33B5E5"/>
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#FF1C1C1C"/>
            <stroke android:width="1dp" android:color="#FF3A3A3A"/>
        </shape>
    </item>
</selector>
