<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom navigation (Home / Shorts / Subscriptions / Library), added by ui.NavBar -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <View
        android:layout_width="fill_parent"
        android:layout_height="1dp"
        android:background="#FF272727"/>
    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#FF0F0F0F">
        <TextView android:id="@+id/nav_home" style="@style/NavItem"
            android:drawableTop="@drawable/nav_home" android:text="@string/home"/>
        <TextView android:id="@+id/nav_shorts" style="@style/NavItem"
            android:drawableTop="@drawable/nav_shorts" android:text="@string/shorts"/>
        <TextView android:id="@+id/nav_subs" style="@style/NavItem"
            android:drawableTop="@drawable/nav_subs" android:text="@string/subscriptions"/>
        <TextView android:id="@+id/nav_library" style="@style/NavItem"
            android:drawableTop="@drawable/nav_library" android:text="@string/library"/>
    </LinearLayout>
</LinearLayout>
