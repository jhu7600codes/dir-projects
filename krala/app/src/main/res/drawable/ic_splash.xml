<?xml version="1.0" encoding="utf-8"?>
<!-- splash icon: android 12 masks the icon to a 160dp circle inside 240dp, so the star sits at
     two thirds of that -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="288dp"
    android:height="288dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="0.2"
        android:scaleY="0.2"
        android:translateX="16"
        android:translateY="16">
        <path android:pathData="M190,40 Q225,155 340,190 Q225,225 190,340 Q155,225 40,190 Q155,155 190,40 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="60"
                    android:startY="60"
                    android:endX="320"
                    android:endY="320">
                    <item android:offset="0" android:color="#FFB3121F" />
                    <item android:offset="0.5" android:color="#FF5A0912" />
                    <item android:offset="1" android:color="#FF000000" />
                </gradient>
            </aapt:attr>
        </path>
    </group>
</vector>
