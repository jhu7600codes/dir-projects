<?xml version="1.0" encoding="utf-8"?>
<!-- api keys are encrypted with a keystore key that never leaves the device, so a cloud
     backup of them would be useless: keep android's auto backup off for the database and prefs -->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="datastore/" />
</full-backup-content>
