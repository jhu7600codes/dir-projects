#!/bin/sh
chown root:wheel /usr/libexec/vlessproxy/vlessctl
chmod 4755 /usr/libexec/vlessproxy/vlessctl
chmod 0755 /usr/libexec/vlessproxy/xray /usr/bin/vless2json
chown root:wheel /Library/LaunchDaemons/com.jhu.vlessproxy.plist
chmod 0644 /Library/LaunchDaemons/com.jhu.vlessproxy.plist
mkdir -p /var/mobile/Library/VLESSProxy
chown mobile:mobile /var/mobile/Library/VLESSProxy
chmod 0700 /var/mobile/Library/VLESSProxy
if [ "$1" = "configure" ] && [ -n "$2" ]; then
  # upgrade: restart the daemon if it was running so the new xray is used
  if /usr/libexec/vlessproxy/vlessctl status >/dev/null 2>&1; then
    /bin/launchctl unload /Library/LaunchDaemons/com.jhu.vlessproxy.plist 2>/dev/null
    /bin/launchctl load -w /Library/LaunchDaemons/com.jhu.vlessproxy.plist 2>/dev/null
  fi
fi
exit 0
