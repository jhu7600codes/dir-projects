<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- TV support: both declared not-required, so the same single APK
         installs on phones (no leanback feature, has a touchscreen) and TV
         (has leanback, no touchscreen) alike. Without the touchscreen one
         specifically, Android/the Play Store assume a touchscreen IS
         required by default and hide the app from TV devices entirely,
         regardless of the LEANBACK_LAUNCHER entry point below. See
         DeviceUtils.isTv's kdoc for how the app actually behaves once
         launched on a TV (routes straight into the native
         browse/watch/comments shell; MainActivity's WebView has no
         story for a device with no touchscreen and no pointer). -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:name=".MaytubeApp"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:banner="@drawable/tv_banner"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Maytube"
        android:supportsRtl="true"
        tools:targetApi="34">

        <!-- MainActivity is the entry point on both phone and TV; see
             DeviceUtils.isTv's kdoc + MainActivity.onCreate: on a TV it
             immediately hands off to HomeActivity (the native shell) and
             never inflates its own WebView layout at all. Keeping one
             entry point rather than a separate TV-only Activity avoids
             duplicating that redirect logic. -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.DownloadsActivity"
            android:exported="false"
            android:label="@string/downloads_title"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.PlayerActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize"
            android:label="@string/player_title"
            android:parentActivityName=".ui.MainActivity" />

        <!-- Settings > native player: MainActivity redirects here instead
             of loading its WebView at all, see MainActivity.onCreate -->
        <activity
            android:name=".ui.HomeActivity"
            android:exported="false"
            android:label="@string/native_mode_home_title" />

        <activity
            android:name=".ui.SearchActivity"
            android:exported="false"
            android:label="@string/action_search"
            android:parentActivityName=".ui.HomeActivity" />

        <activity
            android:name=".ui.WatchActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize"
            android:parentActivityName=".ui.HomeActivity" />

        <activity
            android:name=".ui.ChannelActivity"
            android:exported="false"
            android:parentActivityName=".ui.HomeActivity" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
