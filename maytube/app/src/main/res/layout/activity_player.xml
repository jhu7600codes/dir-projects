<?xml version="1.0" encoding="utf-8"?>
<!--
    Deliberately not the WebView fullscreen dance (MaytubeWebChromeClient):
    this is a plain android.widget.VideoView, which already does exactly
    what was asked for: fits the whole frame inside its bounds, centered,
    no cropping/zooming, with zero Chromium-custom-view state machine to
    fight. See PlayerActivity's kdoc for the buffer-then-play tradeoff this
    makes in exchange for that simplicity.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <VideoView
        android:id="@+id/playerVideoView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <!-- top bar: title + close + fullscreen toggle, always visible (no
         auto-hide: one less state machine, and this is a debug/utility
         player, not trying to look like a polished commercial one) -->
    <LinearLayout
        android:id="@+id/playerTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#99000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <ImageButton
            android:id="@+id/playerCloseButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/player_close"
            android:src="@drawable/ic_close"
            app:tint="@color/maytube_white" />

        <TextView
            android:id="@+id/playerTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:textColor="@color/maytube_white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/playerFullscreenButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/player_fullscreen"
            android:src="@drawable/ic_fullscreen"
            app:tint="@color/maytube_white" />

    </LinearLayout>

    <!-- buffering overlay: whole video is fetched via the same SABR
         fragment pipeline the downloader uses before playback can start
         at all (see PlayerActivity kdoc) -->
    <LinearLayout
        android:id="@+id/playerBufferingOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <ProgressBar
            android:id="@+id/playerBufferingSpinner"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:max="1000" />

        <TextView
            android:id="@+id/playerBufferingText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:textColor="@color/maytube_white"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/playerCancelButton"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/download_cancel"
            android:textColor="@color/maytube_white" />

    </LinearLayout>

    <!-- error overlay -->
    <LinearLayout
        android:id="@+id/playerErrorOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/playerErrorText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/maytube_white"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/playerRetryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/maytube_red"
            android:text="@string/player_retry"
            android:textColor="@color/maytube_white" />

    </LinearLayout>

</FrameLayout>
