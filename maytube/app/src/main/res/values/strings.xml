<resources>
    <string name="app_name">maytube</string>

    <!-- Setup / Settings -->
    <string name="settings_title">Instance settings</string>
    <string name="setup_heading">Connect to your yt2009 instance</string>
    <string name="setup_subheading">Enter the IP address (or hostname) and port of the yt2009 server you want this app to load. You can change this later from the menu.</string>
    <string name="label_host">Server IP or hostname</string>
    <string name="hint_host">e.g. 192.168.1.20</string>
    <string name="label_port">Port</string>
    <string name="hint_port">e.g. 3000</string>
    <string name="label_https">Use HTTPS</string>
    <string name="label_use_sabr">Enable SABR playback</string>
    <string name="label_use_sabr_desc">Sets the exp_sabr flag so yt2009 streams video through its SABR/MSE player. Turn off only to debug.</string>
    <string name="label_prefer_1080p">Prefer 1080p when available</string>
    <string name="label_prefer_1080p_desc">Sets the hd_1080 flag yt2009 checks for the HD quality button.</string>
    <string name="label_dark_mode">Dark mode</string>
    <string name="label_dark_mode_desc">yt2009 has no dark theme of its own, so this inverts the page (and un-inverts thumbnails/video so they still look normal). Not pixel-perfect, but usable in the dark.</string>
    <string name="label_native_player">Native player (experimental)</string>
    <string name="label_native_player_desc">Plays video in maytube\'s own player instead of the WebView\'s. Fixes fullscreen (video is centered/letterboxed, never cropped or wedged) at the cost of buffering the whole video before playback starts -- no live streaming yet. Still uses SABR to fetch it. The WebView is still used for browsing/search either way.</string>
    <string name="action_save">Save &amp; connect</string>
    <string name="error_host_required">Enter a server IP or hostname</string>
    <string name="error_port_invalid">Enter a valid port (1–65535)</string>

