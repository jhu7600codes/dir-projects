<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Vault" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/vault_accent</item>
        <item name="colorOnPrimary">@color/vault_on_surface</item>
        <item name="colorSecondary">@color/vault_accent_variant</item>
        <item name="colorSurface">@color/vault_surface</item>
        <item name="colorOnSurface">@color/vault_on_surface</item>
        <item name="android:statusBarColor">@color/vault_sky_top</item>
        <item name="android:windowBackground">@color/vault_surface</item>
    </style>

    <!-- Full-bleed game screen: no system chrome nudging the HUD/lanes around. -->
    <style name="Theme.Vault.Game" parent="Theme.Vault">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@color/vault_skyline</item>
    </style>
</resources>
