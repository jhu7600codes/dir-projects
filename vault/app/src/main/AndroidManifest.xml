<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- No permissions needed: gameplay, saves, and the local leaderboard are all fully
         offline (DataStore JSON file on-device only). -->

    <application
        android:name=".VaultApp"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.Vault"
        android:supportsRtl="true"
        android:hardwareAccelerated="true"
        tools:targetApi="34">

        <activity
            android:name=".ui.MainMenuActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Vault">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The Canvas-driven game screen: locked to whatever orientation it started in
             instead of restarting the activity (and losing the running GameSession) on a
             config change. -->
        <activity
            android:name=".ui.GameActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize"
            android:theme="@style/Theme.Vault.Game"
            android:parentActivityName=".ui.MainMenuActivity" />

        <activity
            android:name=".ui.ResultsActivity"
            android:exported="false"
            android:label="@string/results_title"
            android:screenOrientation="portrait"
            android:parentActivityName=".ui.MainMenuActivity" />

        <activity
            android:name=".ui.ShopActivity"
            android:exported="false"
            android:label="@string/shop_title"
            android:parentActivityName=".ui.MainMenuActivity" />

        <activity
            android:name=".ui.MissionsActivity"
            android:exported="false"
            android:label="@string/missions_title"
            android:parentActivityName=".ui.MainMenuActivity" />

        <activity
            android:name=".ui.SkinSelectActivity"
            android:exported="false"
            android:label="@string/skins_title"
            android:parentActivityName=".ui.MainMenuActivity" />

        <activity
            android:name=".ui.DailyChallengeActivity"
            android:exported="false"
            android:label="@string/daily_title"
            android:parentActivityName=".ui.MainMenuActivity" />

        <activity
            android:name=".ui.AchievementsActivity"
            android:exported="false"
            android:label="@string/achievements_title"
            android:parentActivityName=".ui.MainMenuActivity" />

        <activity
            android:name=".ui.LeaderboardActivity"
            android:exported="false"
            android:label="@string/leaderboard_title"
            android:parentActivityName=".ui.MainMenuActivity" />

    </application>

</manifest>
