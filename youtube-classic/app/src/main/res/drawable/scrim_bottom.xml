<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- angle=90 runs bottom-to-top (startColor at the bottom edge,
         endColor at the top) - start dark right at the screen edge behind
         the text/buttons and fade to transparent going up into the video.
         This was previously backwards (transparent at the bottom, opaque
         at the top of this 180dp strip), which showed as a hard dark line
         180dp above the bottom edge instead of a smooth scrim. -->
    <gradient
        android:type="linear"
        android:angle="90"
        android:startColor="#B3000000"
        android:endColor="#00000000" />
</shape>
