<?xml version="1.0" encoding="utf-8"?>
<!-- Custom Media3 controller layout, wired in via
     app:controller_layout_id on the PlayerView in activity_player.xml.
     Reserved ids (exo_play_pause, exo_progress, exo_position, exo_duration,
     exo_fullscreen) MUST use "@id/..." here, never "@+id/..." - see the
     kdoc this replaced in git history for why.

     The real 2019 player didn't have dedicated rewind/forward buttons
     flanking play/pause - just a big center tap target and double-tap
     zones on either side of the screen to skip back/forward (wired up in
     PlayerActivity via a GestureDetector, not here), plus a top bar with
     back/title/overflow that shows and hides with the rest of the
     controls. This layout matches that instead of a generic media-player
     transport bar. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#4D000000" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#66000000"
        android:paddingHorizontal="4dp">

        <ImageButton
            android:id="@+id/playerBackButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="@null"
            android:src="@drawable/ic_arrow_back"
            app:tint="@android:color/white" />

        <TextView
            android:id="@+id/playerTitleText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            tools:text="Video title" />

        <ImageButton
            android:id="@+id/playerOverflowButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="@null"
            android:src="@drawable/ic_more_vert"
            app:tint="@android:color/white" />

    </LinearLayout>

    <ImageButton
        android:id="@id/exo_play_pause"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:background="@android:color/transparent"
        android:contentDescription="@null"
        android:src="@drawable/ic_play_arrow" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp">

        <TextView
            android:id="@id/exo_position"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            tools:text="0:42" />

        <androidx.media3.ui.DefaultTimeBar
            android:id="@id/exo_progress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            app:played_color="@color/yt_scrubber_played"
            app:buffered_color="@color/yt_scrubber_buffered"
            app:unplayed_color="@color/yt_scrubber_background"
            app:scrubber_color="@color/yt_scrubber_played"
            app:ad_marker_color="@color/sponsorblock_segment"
            app:played_ad_marker_color="@color/sponsorblock_segment" />

        <TextView
            android:id="@id/exo_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            tools:text="10:00" />

        <ImageButton
            android:id="@id/exo_fullscreen"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:contentDescription="@null"
            android:src="@drawable/ic_fullscreen" />

    </LinearLayout>

</merge>
